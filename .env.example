# ---------- smart contract ----------
# Deployer. SENDS transactions -> needs Base Sepolia ETH from
# https://portal.cdp.coinbase.com/products/faucet
PRIVATE_KEY=0x
# Etherscan V2: satu key dari etherscan.io untuk semua chain. Key basescan.org sudah mati.
ETHERSCAN_API_KEY=
# Pemegang otoritas upgrade UUPS. Simpan di luar environment backend dan deploy.
UPGRADE_ADMIN_ADDRESS=0xC0586732a09f983d32B3C85AcC4988CfE2E02491

# ---------- x402 ----------
# Facilitator testnet gratis, tanpa API key. CATATAN: facilitator.x402.org (README resmi) = NXDOMAIN.
FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=eip155:84532
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Penerima pembayaran. WAJIB EOA biasa, JANGAN alamat proxy PromitRegistry:
# registry tidak punya jalur penarikan, jadi USDC yang masuk ke sana tidak bisa diambil
# tanpa upgrade. Registry hanya mencatat, tidak pernah menyimpan dana.
PAY_TO_ADDRESS=0x

# ---------- backend ----------
PORT=3001
DATABASE_URL=
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Alamat proxy registry. Berbeda dari PAY_TO_ADDRESS.
PROMIT_REGISTRY_ADDRESS=0x30c92fFadAd24Ca079227A92A33b78683D36Fde6
# Settler. Memegang HANYA settler role, tidak bisa upgrade kontrak.
# SENDS transactions -> butuh Base Sepolia ETH.
SETTLER_ADDRESS=0xdf280D5038C5E5D489941318D331fa4C06b91345
SETTLER_PRIVATE_KEY=0x

# ---------- frontend ----------
NEXT_PUBLIC_API_URL=https://promitbackend-production.up.railway.app
NEXT_PUBLIC_CHAIN_ID=84532

# ---------- agent (MCP / CLI) ----------
# Wallet agent cukup diisi USDC; ETH tidak perlu, facilitator yang bayar gas.
# MCP server tidak bisa prompt password (stdin = kanal JSON-RPC), jadi jalur
# non-interaktifnya HANYA variabel ini. Jangan pernah tulis nilainya ke .mcp.json.
PROMIT_AGENT_PRIVATE_KEY=0x
# Batas per prompt DAN batas kumulatif. Keduanya wajib: cap per-prompt saja
# tidak menahan 200 pembelian yang masing-masing tepat di bawah ambang.
PROMIT_MAX_PER_PROMPT_USDC=0.50
PROMIT_SESSION_CAP_USDC=5.00

# ---------- wallet connect (Reown AppKit) ----------
# Project ID publik dari dashboard Reown; aman di klien, memang NEXT_PUBLIC_.
NEXT_PUBLIC_REOWN_PROJECT_ID=
