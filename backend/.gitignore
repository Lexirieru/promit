# raw media downloads — only the optimized media/ output is committed
.media-cache/
# runtime store (KTD17): paid bodies and unlock records must never be committed
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
# U16's workspace root owns dependency locking; a nested lock would go stale
bun.lock
# U7: upload media kreator (runtime) — hanya output mirror seed yang di-commit
media/uploads/
# Exception: a creator upload restored by hand after it was lost from the
# ephemeral disk. A mounted volume cannot be written to from a deploy, so
# committing the file under its serving path is the only way to ship it.
# The route prefers the volume, so a fresh runtime upload still wins.
!media/uploads/floating-navbar-hero.mp4

