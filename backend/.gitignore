# raw media downloads — only the optimized media/ output is committed
.media-cache/
# runtime store (KTD17): paid bodies and unlock records must never be committed
data/*.sqlite
data/*.sqlite-wal
data/*.sqlite-shm
# U16's workspace root owns dependency locking; a nested lock would go stale
bun.lock
# U7: upload media kreator (runtime) — hanya output mirror seed yang di-commit
media/uploads/
